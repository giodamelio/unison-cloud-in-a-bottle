-- Adds a `postgres` storage config, which 0004-postgres-storage.u serves from a PostgreSQL
-- table instead of DynamoDB. It lives in `Dynamo.Config` because that's what the dynamic
-- config and `stateful.runStorage` already pass around.
--
-- ucm can't load this type change and the code that uses it in a single update, so the
-- storage code is a separate patch.
--
-- The session always asks for `bytea_output = hex`, which the storage code's `bytea`
-- codec reads, whatever the server's default.

type stateful.Dynamo.Config
  = Cloud Region Credentials Text
  | Local Credentials HostName Port Text
  | Postgres PostgresClientConfig Text

stateful.Dynamo.table : Dynamo.Config -> Text
stateful.Dynamo.table = cases
  Cloud _ _ name          -> name
  Config.Local _ _ _ name -> name
  Config.Postgres _ name  -> name

ServerState.config.read.dynamoConfig : '{json_1_2_1.Decoder} Dynamo.Config
ServerState.config.read.dynamoConfig =
  do
    use object at!
    match at! "type" Decoder.text with
      "local" ->
        Config.Local
          (at! "credentials" aws.credentials)
          (at! "host" json.hostName)
          (at! "port" json.port)
          "test"
      "cloud" ->
        Cloud
          (at! "region" aws.region)
          (at! "credentials" aws.credentials)
          (at! "table" Decoder.text)
      "postgres" ->
        Config.Postgres
          (PostgresClientConfig.PostgresClientConfig
            (at! "host" json.hostName)
            (at! "port" json.port)
            (UserName.UserName (at! "user" Decoder.text))
            (DatabaseName.DatabaseName (at! "database" Decoder.text))
            (optionalAt! "password" Decoder.text |> Optional.map Password.Password)
            (Map.put "bytea_output" "hex" defaultConnectionParameters)
            BuiltinsOnly)
          (at! "table" Decoder.text)
      other ->
        Decoder.fail ("Unknown DynamoDB config type: " Text.++ other)

stateful.Dynamo.call :
  Dynamo.Config
  -> Text
  -> Json
  -> '{g, Exception, json_1_2_1.Decoder} a
  ->{g, IO, Exception, Http} a
stateful.Dynamo.call config opName op decoder =
  use HttpRequest setHeader
  use Text ++
  service = unison_aws_5_2_0.Service.Service "dynamodb"
  (region, creds, scheme, host, port) =
    match config with
      Config.Local credentials host port _ ->
        (Region "", credentials, Scheme.http, HostName.toText host, Some port)
      Config.Postgres _ _ ->
        bug "stateful.Dynamo.call: a postgres config has no DynamoDB endpoint"
      Cloud region credentials _ ->
        ( region
        , credentials
        , Scheme.https
        , "dynamodb." ++ Region.name region ++ ".amazonaws.com"
        , None
        )
  uri =
    URI
      scheme
      (Some (Authority None (HostName host) port))
      Path.root
      RawQuery.empty
      Fragment.empty
  instant = Instant.now()
  date = Instant.toBasicISO8601 (truncateToSeconds instant)
  payload = op |> unison_json_1_3_5.core.Json.toText |> Text.toUtf8
  size = Nat.toText (Bytes.size payload)
  req =
    HttpRequest.post uri (Body payload)
      |> setHeader "Accept-Encoding" ["identity"]
      |> setHeader "User-Agent" ["Unison"]
      |> setHeader "Content-Length" [size]
      |> setHeader "X-AMZ-Date" [date]
      |> setHeader "X-AMZ-Target" ["DynamoDB_20120810." ++ opName]
      |> setHeader "Content-Type" ["application/x-amz-json-1.0"]
      |> addSecurityTokenHeader creds
      |> addAuthorizationHeader creds instant region service
  Http.request req
    |> HttpResponse.body
    |> Body.toBytes
    |> fromUtf8
    |> unison_json_1_3_5.Decoder.run decoder
