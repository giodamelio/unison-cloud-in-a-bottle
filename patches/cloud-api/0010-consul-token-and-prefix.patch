+-- The prefix also forms service names, which must stay DNS-compatible.
+parseConsulPrefix :: String -> Either String Text
+parseConsulPrefix str
+  | not (null str) && all (\c -> isAsciiLower c || isDigit c || c == '-') str = Right (Text.pack str)
+  | otherwise = Left ("must be lowercase letters, digits and dashes, got " <> show str)
+
+-- Every Consul call goes through this env, including the long-poll copies that only change its timeout.
+withConsulToken :: Maybe String -> ClientEnv -> ClientEnv
+withConsulToken Nothing env = env
+withConsulToken (Just token) env =
+  env
+    { makeClientRequest = \url req ->
+        makeClientRequest env url req <&> \r ->
+          r {requestHeaders = ("X-Consul-Token", BS.pack token) : requestHeaders r}
+    }
+
 parseS3AddressingStyle :: String -> Either String AWS.S3AddressingStyle
 parseS3AddressingStyle = \case
   "path" -> Right AWS.S3AddressingStylePath
