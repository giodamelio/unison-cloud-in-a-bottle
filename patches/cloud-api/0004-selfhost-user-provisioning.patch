--- a/src/Cloud/SelfHost/Provision.hs
+++ b/src/Cloud/SelfHost/Provision.hs
@@ -0,0 +1,90 @@
+module Cloud.SelfHost.Provision
+  ( Identity (..),
+    ProvisionError (..),
+    provisionUser,
+  )
+where
+
+import Cloud.Postgres qualified as PG
+import Cloud.Postgres.Queries qualified as Q
+import Cloud.Prelude
+import Cloud.User.Types (CloudTier (..))
+import Cloud.Utils (isValidDNSName)
+import Control.Monad (unless)
+import Control.Monad.Except (runExceptT, throwError)
+import Control.Monad.Trans (lift)
+import Crypto.Hash (Digest, MD5, hash)
+import Data.Char qualified as Char
+import Data.Text qualified as Text
+import Data.Text.Encoding (encodeUtf8)
+import Share.OAuth.Types (UserId)
+
+-- | An identity verified by the OIDC provider.
+data Identity = Identity
+  { issuer :: Text,
+    subject :: Text,
+    preferredUsername :: Maybe Text,
+    email :: Maybe Text
+  }
+
+data ProvisionError
+  = MissingClaim Text
+  | InvalidHandle Text
+  | HandleTaken Text
+  | UnsupportedTier CloudTier
+  deriving stock (Show)
+
+-- | Finds or creates the user for an identity, and makes sure they're enrolled in the tier.
+--
+-- Every error is raised before the first write, so the caller's transaction can commit either way.
+provisionUser :: CloudTier -> Identity -> PG.Transaction e (Either ProvisionError UserId)
+provisionUser tier Identity {issuer, subject, preferredUsername, email} = runExceptT do
+  enroll <- case tier of
+    Free -> pure Q.addToFreeTier
+    Starter -> pure \userId -> Q.userByUserId userId >>= maybe (error "provisionUser: user vanished mid-transaction") Q.addToPaidTier
+    Pro -> throwError (UnsupportedTier tier)
+  existing <-
+    lift $
+      PG.query1Col
+        [PG.sql|
+            SELECT user_id FROM selfhost.oidc_identities
+              WHERE issuer = #{issuer} AND subject = #{subject}
+          |]
+  userId <- maybe createUser pure existing
+  lift do
+    enroll userId
+    -- Upstream grants daemons only to paying users and the cloud org; self-hosted users all get them.
+    PG.execute_
+      [PG.sql|
+          INSERT INTO cloud_daemon_users (id) VALUES (#{userId})
+            ON CONFLICT DO NOTHING
+        |]
+  pure userId
+  where
+    createUser = do
+      username <- maybe (throwError (MissingClaim "preferred username")) pure preferredUsername
+      primaryEmail <- maybe (throwError (MissingClaim "email")) pure email
+      let handle = Text.toLower username
+      -- Handles end up as DNS labels in service hostnames.
+      unless (Text.all Char.isAscii handle && isValidDNSName handle) $ throwError (InvalidHandle handle)
+      taken <- lift $ PG.queryExpect1Col [PG.sql| SELECT EXISTS (SELECT 1 FROM users WHERE handle = #{handle}) |]
+      when taken $ throwError (HandleTaken handle)
+      -- cloud-api decodes avatar_url as non-null, so every user needs one.
+      let avatarUrl = "https://www.gravatar.com/avatar/" <> tshow (gravatarHash primaryEmail) <> "?d=identicon"
+      lift do
+        userId <-
+          PG.queryExpect1Col
+            [PG.sql|
+                INSERT INTO users (primary_email, email_verified, avatar_url, handle)
+                  VALUES (#{primaryEmail}, true, #{avatarUrl}, #{handle})
+                  RETURNING id
+              |]
+        PG.execute_
+          [PG.sql|
+              INSERT INTO selfhost.oidc_identities (issuer, subject, user_id)
+                VALUES (#{issuer}, #{subject}, #{userId})
+            |]
+        pure userId
+
+    gravatarHash :: Text -> Digest MD5
+    gravatarHash = hash . encodeUtf8 . Text.toLower . Text.strip
