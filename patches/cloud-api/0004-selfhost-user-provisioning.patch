--- a/docker/sql/2099-01-02-00_selfhost_oidc_identities.sql
+++ b/docker/sql/2099-01-02-00_selfhost_oidc_identities.sql
@@ -0,0 +1,17 @@
+CREATE SCHEMA IF NOT EXISTS selfhost;
+
+-- Keyed on the provider's subject, not the username, so renaming yourself at the
+-- provider never maps you onto someone else's account.
+CREATE TABLE selfhost.oidc_identities (
+  issuer text NOT NULL,
+  subject text NOT NULL,
+  user_id uuid NOT NULL REFERENCES public.users (id) ON DELETE CASCADE,
+  created_at timestamptz NOT NULL DEFAULT now(),
+  PRIMARY KEY (issuer, subject)
+);
+
+-- Upstream only seeds cloud_tiers from its test fixtures, and the fake Starter
+-- subscription given to new users needs the Starter tier's product ID.
+INSERT INTO public.cloud_tiers (stripe_product_id, name, default_stripe_price_id)
+  VALUES ('prod_selfhost_starter', 'Starter', 'price_selfhost_starter')
+  ON CONFLICT DO NOTHING;
