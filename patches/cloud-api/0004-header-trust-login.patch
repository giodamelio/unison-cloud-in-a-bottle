+{-# LANGUAGE DataKinds #-}
+{-# LANGUAGE TypeOperators #-}
+
+module Cloud.SelfHost.HeaderAuth.API (API) where
+
+import Cloud.Prelude
+import Servant
+import Share.Utils.Servant.Cookies qualified as Cookies
+import Share.Utils.URI (URIParam)
+
+-- | Only safe behind a reverse proxy that strips these headers from every request and
+-- sets them from the identity oauth2-proxy verified.
+type API =
+  Header "X-Auth-Request-User" Text
+    :> Header "X-Auth-Request-Preferred-Username" Text
+    :> Header "X-Auth-Request-Email" Text
+    :> ( ("login" :> LoginEndpoint)
+           :<|> ("access-token" :> AccessTokenEndpoint)
+       )
+
+-- | GET /selfhost/login
+-- Sets the session cookie and redirects to the cloud UI.
+type LoginEndpoint =
+  QueryParam "return_to" URIParam
+    :> Verb 'GET 302 '[PlainText] (Headers '[Header "Set-Cookie" Cookies.SetCookie, Header "Location" String] NoContent)
+
+-- | GET /selfhost/access-token
+-- Returns a bearer token for UNISON_CLOUD_ACCESS_TOKEN.
+type AccessTokenEndpoint =
+  Get '[PlainText] Text
