+{-# LANGUAGE DataKinds #-}
+
+-- | Login for a self-hosted deployment: a reverse proxy runs the OIDC login through
+-- oauth2-proxy and passes the verified identity to these endpoints as headers.
+module Cloud.SelfHost.HeaderAuth
+  ( server,
+  )
+where
+
+import Cloud.Env (Env (..))
+import Cloud.Errors (ErrorID (..), ToServerError (..), respondError)
+import Cloud.Postgres qualified as PG
+import Cloud.Postgres.App (postgresM)
+import Cloud.Prelude
+import Cloud.SelfHost.HeaderAuth.API (API)
+import Cloud.SelfHost.Provision (Identity (..), ProvisionError (..), provisionUser)
+import Cloud.User.App (authM)
+import Cloud.User.Env (AuthEnv (..))
+import Cloud.User.Impl (enlilAud, enlilIssuer)
+import Cloud.Utils.Logging qualified as Logging
+import Cloud.Web.App (WebApp, isCloudUILink)
+import Cloud.Web.Local.Impl (AccessTokenClaims (..), newStandardClaims, signJWT)
+import Control.Monad.Random (randomIO)
+import Control.Monad.Reader (ask, asks)
+import Data.ByteString.Lazy (fromStrict)
+import Data.Set qualified as Set
+import Data.Text.Encoding (encodeUtf8)
+import Data.Time (NominalDiffTime, addUTCTime, nominalDay)
+import Servant
+import Share.JWT qualified as ShareJWT
+import Share.OAuth.Scopes (Scopes (..))
+import Share.OAuth.Scopes qualified as Scopes
+import Share.OAuth.Session (Session (..))
+import Share.OAuth.Session qualified as Session
+import Share.OAuth.Types (UserId)
+import Share.Utils.Servant.Cookies qualified as Cookies
+import Share.Utils.URI (URIParam (..))
+
+data HeaderAuthError
+  = MissingUserHeader
+  | ProvisionFailed ProvisionError
+  | SigningFailed Text
+
+instance Logging.Loggable HeaderAuthError where
+  toLog = \case
+    MissingUserHeader -> Logging.withSeverity Logging.UserFault $ Logging.textLog "selfhost login without X-Auth-Request-User"
+    ProvisionFailed err -> Logging.withSeverity Logging.UserFault . Logging.textLog $ "selfhost login failed: " <> tshow err
+    SigningFailed err -> Logging.withSeverity Logging.Error . Logging.textLog $ "selfhost login failed to sign a token: " <> err
+
+instance ToServerError HeaderAuthError where
+  toServerError = \case
+    MissingUserHeader ->
+      (ErrorID "selfhost:unauthenticated", err401 {errBody = "Missing X-Auth-Request-User: this endpoint must sit behind the login proxy."})
+    ProvisionFailed err -> case err of
+      MissingClaim claim ->
+        (ErrorID "selfhost:missing-claim", err403 {errBody = "The identity provider didn't supply your " <> encode claim <> ", which a new account needs."})
+      InvalidHandle handle ->
+        (ErrorID "selfhost:invalid-handle", err403 {errBody = "Your username " <> encode handle <> " isn't a valid handle: it must start with a letter and contain only letters, digits and hyphens, at most 63 characters."})
+      HandleTaken handle ->
+        (ErrorID "selfhost:handle-taken", err409 {errBody = "The handle " <> encode handle <> " already belongs to another account."})
+      UnsupportedTier tier ->
+        (ErrorID "selfhost:unsupported-tier", err500 {errBody = "Unsupported default tier " <> encode (tshow tier) <> "."})
+    SigningFailed _ -> (ErrorID "selfhost:signing-failed", err500)
+    where
+      encode = fromStrict . encodeUtf8
+
+-- | Shorter than the 300 days of the local-only tokens, since tokens can't be revoked.
+accessTokenTTL :: NominalDiffTime
+accessTokenTTL = 30 * nominalDay
+
+server :: ServerT API WebApp
+server userHeader usernameHeader emailHeader =
+  loginEndpoint :<|> accessTokenEndpoint
+  where
+    provision :: WebApp UserId
+    provision = do
+      subject <- maybe (respondError MissingUserHeader) pure userHeader
+      issuer <- asks envSelfHostOidcIssuer
+      tier <- asks envSelfHostDefaultTier
+      let identity = Identity {issuer, subject, preferredUsername = usernameHeader, email = emailHeader}
+      postgresM (PG.runTransaction (provisionUser tier identity)) >>= either (respondError . ProvisionFailed) pure
+
+    loginEndpoint :: Maybe URIParam -> WebApp (Headers '[Header "Set-Cookie" Cookies.SetCookie, Header "Location" String] NoContent)
+    loginEndpoint returnTo = do
+      userId <- provision
+      iss <- enlilIssuer
+      aud <- enlilAud
+      session <- Session.createSession iss (Set.singleton aud) userId
+      -- share-auth's sessions last a year; bound the cookie's JWT like the access tokens.
+      let session' = session {sessionExpiry = addUTCTime accessTokenTTL (sessionCreated session)}
+      cookie <- authM do
+        AuthEnv {envSessionCookieName, envCookieSettings, envJwtSettings} <- ask
+        ShareJWT.createSignedCookie envJwtSettings envCookieSettings envSessionCookieName session'
+      setCookie <- either (respondError . SigningFailed . tshow) pure cookie
+      uiOrigin <- asks envCloudUiOrigin
+      -- Like the Share login callback, only return to the cloud UI, never an arbitrary site.
+      target <- case returnTo of
+        Just (URIParam uri) -> isCloudUILink uri <&> \valid -> if valid then uri else uiOrigin
+        Nothing -> pure uiOrigin
+      pure $ addHeader setCookie (addHeader (show target) NoContent)
+
+    accessTokenEndpoint :: WebApp Text
+    accessTokenEndpoint = do
+      userId <- provision
+      sessionId <- randomIO
+      aud <- enlilAud
+      standardClaims <- newStandardClaims aud userId accessTokenTTL sessionId
+      signed <- signJWT AccessTokenClaims {standardClaims, scope = Scopes (Set.fromList [Scopes.OpenId, Scopes.Cloud])}
+      pure (ShareJWT.signedJWTToText signed)
--- a/src/Cloud/SelfHost/Provision.hs
+++ b/src/Cloud/SelfHost/Provision.hs
@@ -0,0 +1,90 @@
+module Cloud.SelfHost.Provision
+  ( Identity (..),
+    ProvisionError (..),
+    provisionUser,
+  )
+where
+
+import Cloud.Postgres qualified as PG
+import Cloud.Postgres.Queries qualified as Q
+import Cloud.Prelude
+import Cloud.User.Types (CloudTier (..))
+import Cloud.Utils (isValidDNSName)
+import Control.Monad (unless)
+import Control.Monad.Except (runExceptT, throwError)
+import Control.Monad.Trans (lift)
+import Crypto.Hash (Digest, MD5, hash)
+import Data.Char qualified as Char
+import Data.Text qualified as Text
+import Data.Text.Encoding (encodeUtf8)
+import Share.OAuth.Types (UserId)
+
+-- | An identity verified by the OIDC provider.
+data Identity = Identity
+  { issuer :: Text,
+    subject :: Text,
+    preferredUsername :: Maybe Text,
+    email :: Maybe Text
+  }
+
+data ProvisionError
+  = MissingClaim Text
+  | InvalidHandle Text
+  | HandleTaken Text
+  | UnsupportedTier CloudTier
+  deriving stock (Show)
+
+-- | Finds or creates the user for an identity, and makes sure they're enrolled in the tier.
+--
+-- Every error is raised before the first write, so the caller's transaction can commit either way.
+provisionUser :: CloudTier -> Identity -> PG.Transaction e (Either ProvisionError UserId)
+provisionUser tier Identity {issuer, subject, preferredUsername, email} = runExceptT do
+  enroll <- case tier of
+    Free -> pure Q.addToFreeTier
+    Starter -> pure \userId -> Q.userByUserId userId >>= maybe (error "provisionUser: user vanished mid-transaction") Q.addToPaidTier
+    Pro -> throwError (UnsupportedTier tier)
+  existing <-
+    lift $
+      PG.query1Col
+        [PG.sql|
+            SELECT user_id FROM selfhost.oidc_identities
+              WHERE issuer = #{issuer} AND subject = #{subject}
+          |]
+  userId <- maybe createUser pure existing
+  lift do
+    enroll userId
+    -- Upstream grants daemons only to paying users and the cloud org; self-hosted users all get them.
+    PG.execute_
+      [PG.sql|
+          INSERT INTO cloud_daemon_users (id) VALUES (#{userId})
+            ON CONFLICT DO NOTHING
+        |]
+  pure userId
+  where
+    createUser = do
+      username <- maybe (throwError (MissingClaim "preferred username")) pure preferredUsername
+      primaryEmail <- maybe (throwError (MissingClaim "email")) pure email
+      let handle = Text.toLower username
+      -- Handles end up as DNS labels in service hostnames.
+      unless (Text.all Char.isAscii handle && isValidDNSName handle) $ throwError (InvalidHandle handle)
+      taken <- lift $ PG.queryExpect1Col [PG.sql| SELECT EXISTS (SELECT 1 FROM users WHERE handle = #{handle}) |]
+      when taken $ throwError (HandleTaken handle)
+      -- cloud-api decodes avatar_url as non-null, so every user needs one.
+      let avatarUrl = "https://www.gravatar.com/avatar/" <> tshow (gravatarHash primaryEmail) <> "?d=identicon"
+      lift do
+        userId <-
+          PG.queryExpect1Col
+            [PG.sql|
+                INSERT INTO users (primary_email, email_verified, avatar_url, handle)
+                  VALUES (#{primaryEmail}, true, #{avatarUrl}, #{handle})
+                  RETURNING id
+              |]
+        PG.execute_
+          [PG.sql|
+              INSERT INTO selfhost.oidc_identities (issuer, subject, user_id)
+                VALUES (#{issuer}, #{subject}, #{userId})
+            |]
+        pure userId
+
+    gravatarHash :: Text -> Digest MD5
+    gravatarHash = hash . encodeUtf8 . Text.toLower . Text.strip
