 exitErrOnLeft :: Either String a -> IO a
 exitErrOnLeft (Right a) = pure a
 exitErrOnLeft (Left err) = putStrLn ("Error: " <> err) >> exitWith (ExitFailure 1)
+
+parseS3Endpoint :: String -> Either String (Bool, BS.ByteString, Int)
+parseS3Endpoint str = do
+  uri <- maybeToRight ("not an absolute URI: " <> str) (parseAbsoluteURI str)
+  secure <- case uriScheme uri of
+    "http:" -> Right False
+    "https:" -> Right True
+    scheme -> Left ("scheme must be http or https, got " <> scheme)
+  auth <- maybeToRight ("no host in " <> str) (uriAuthority uri)
+  port <- case uriPort auth of
+    "" -> Right (if secure then 443 else 80)
+    ':' : p -> maybeToRight ("invalid port in " <> str) (readMaybe p)
+    p -> Left ("invalid port " <> p)
+  when (uriPath uri `notElem` ["", "/"] || not (null (uriQuery uri)) || not (null (uriUserInfo auth))) $
+    Left ("must be scheme://host[:port] only, got " <> str)
+  pure (secure, BS.pack (uriRegName auth), port)
+
+parseS3AddressingStyle :: String -> Either String AWS.S3AddressingStyle
+parseS3AddressingStyle = \case
+  "path" -> Right AWS.S3AddressingStylePath
+  "virtual" -> Right AWS.S3AddressingStyleVirtual
+  other -> Left ("must be path or virtual, got " <> other)
