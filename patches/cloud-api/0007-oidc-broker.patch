+{-# LANGUAGE DataKinds #-}
+
+-- | Option A login: cloud-api is an OIDC client of the upstream provider, and a minimal
+-- authorization server for ucm's @auth.login@, modeled on Share's broker for GitHub.
+--
+-- Everything here 404s unless @CLOUD_OIDC_ISSUER@ is set.
+module Cloud.SelfHost.Oidc
+  ( server,
+  )
+where
+
+import Cloud.Env (Env (..))
+import Cloud.Errors (ErrorID (..), ToServerError (..), respondError)
+import Cloud.Postgres qualified as PG
+import Cloud.Postgres.App (postgresM)
+import Cloud.Postgres.Ops qualified as PGO
+import Cloud.Prelude
+import Cloud.SelfHost.Oidc.API
+import Cloud.SelfHost.Oidc.Config (Allowlist (..), OidcConfig (..))
+import Cloud.SelfHost.Oidc.RefreshToken (issueRefreshToken, redeemRefreshToken)
+import Cloud.SelfHost.Oidc.Upstream (UpstreamError (..), VerifiedClaims (..))
+import Cloud.SelfHost.Oidc.Upstream qualified as Upstream
+import Cloud.SelfHost.Provision (Identity (..), ProvisionError, provisionUser)
+import Cloud.SelfHost.Tokens (accessTokenTTL, cloudUIReturnTarget, sessionCookie)
+import Cloud.SelfHost.Tokens qualified as Tokens
+import Cloud.User.Env (AuthEnv (..))
+import Cloud.User.Impl (enlilAud, enlilIssuer)
+import Cloud.User.Types (User (..))
+import Cloud.Utils.Logging qualified as Logging
+import Cloud.Web.App (WebApp)
+import Control.Monad (unless)
+import Control.Monad.Random (randomIO)
+import Control.Monad.Reader (asks)
+import Data.Aeson ((.=))
+import Data.Aeson qualified as Aeson
+import Data.Aeson.KeyMap qualified as KeyMap
+import Data.Aeson.Key qualified as Key
+import Data.ByteString.Lazy qualified as BL
+import Data.List qualified as List
+import Data.Set qualified as Set
+import Data.Text qualified as Text
+import Data.Text.Encoding qualified as Text
+import GHC.TypeLits (symbolVal)
+import Network.URI (URIAuth (..))
+import Servant
+import Share.JWT qualified as ShareJWT
+import Share.OAuth.Errors (OAuth2Error)
+import Share.OAuth.PKCE qualified as PKCE
+import Share.OAuth.Redis qualified as Redis
+import Share.OAuth.Scopes (Scopes, UnisonScope (OpenId), containsScope)
+import Share.OAuth.Session (LoginRequest (..), PendingSession (..), Session (..))
+import Share.OAuth.Types (AuthenticationRequest (..), OAuthClientId (..), PKCEChallenge, PKCEChallengeMethod (..), PendingSessionId, ResponseType (..), UserId)
+import Share.Utils.IDs qualified as IDs
+import Share.Utils.SecureTokens (newSecureToken)
+import Share.Utils.Servant.Cookies (cookieVal)
+import Share.Utils.Servant.Cookies qualified as Cookies
+import Share.Utils.URI (URIParam (..), addQueryParam)
+import Web.Cookie (SetCookie (..))
+
+data BrokerError
+  = BrokerDisabled
+  | ProviderRefused Text (Maybe Text)
+  | MissingPendingSession
+  | MismatchedState
+  | MissingCallbackParam Text
+  | UpstreamFailed UpstreamError
+  | NotAllowed Text
+  | ProvisionFailed ProvisionError
+  | UnknownClient OAuthClientId
+  | InvalidRedirectURI URIParam
+  | UnsupportedChallengeMethod
+  | OpenIdScopeRequired
+
+instance Logging.Loggable BrokerError where
+  toLog = \case
+    UpstreamFailed err -> Logging.withSeverity Logging.Error . Logging.textLog $ "oidc login failed upstream: " <> tshow err
+    ProvisionFailed err -> Logging.withSeverity Logging.UserFault . Logging.textLog $ "oidc login failed: " <> tshow err
+    NotAllowed who -> Logging.withSeverity Logging.UserFault . Logging.textLog $ "oidc login refused by the allowlist: " <> who
+    ProviderRefused err desc -> Logging.withSeverity Logging.UserFault . Logging.textLog $ "oidc provider refused the login: " <> err <> maybe "" (": " <>) desc
+    UnknownClient clientId -> Logging.withSeverity Logging.UserFault . Logging.textLog $ "oauth authorize from unknown client " <> tshow clientId
+    InvalidRedirectURI uri -> Logging.withSeverity Logging.UserFault . Logging.textLog $ "oauth authorize with non-loopback redirect_uri " <> tshow uri
+    other ->
+      let (ErrorID errId, _) = toServerError other
+       in Logging.withSeverity Logging.UserFault . Logging.textLog $ "oidc login failed: " <> errId
+
+instance ToServerError BrokerError where
+  toServerError = \case
+    BrokerDisabled -> (ErrorID "selfhost:oidc-disabled", err404)
+    ProviderRefused err desc ->
+      (ErrorID "selfhost:oidc-provider-refused", err403 {errBody = "The identity provider refused the login: " <> encode err <> maybe "" ((" (" <>) . (<> ")") . encode) desc})
+    MissingPendingSession ->
+      (ErrorID "selfhost:oidc-no-pending-session", err400 {errBody = "The login took too long or was started in another browser. Please try again."})
+    MismatchedState -> (ErrorID "selfhost:oidc-mismatched-state", err400 {errBody = "Mismatched state parameter."})
+    MissingCallbackParam param -> (ErrorID "selfhost:oidc-missing-param", err400 {errBody = "Missing " <> encode param <> " parameter."})
+    UpstreamFailed _ -> (ErrorID "selfhost:oidc-upstream-failed", err502 {errBody = "Logging in through the identity provider failed; the server log has details."})
+    NotAllowed _ -> (ErrorID "selfhost:oidc-not-allowed", err403 {errBody = "Your account isn't allowed to log in here."})
+    ProvisionFailed err -> toServerError err
+    UnknownClient _ -> (ErrorID "selfhost:oauth-unknown-client", err400 {errBody = "Unknown client_id; only ucm may use this server."})
+    InvalidRedirectURI _ -> (ErrorID "selfhost:oauth-invalid-redirect-uri", err400 {errBody = "redirect_uri must be an http URL on a loopback address."})
+    UnsupportedChallengeMethod -> (ErrorID "selfhost:oauth-pkce-method", err400 {errBody = "code_challenge_method must be S256."})
+    OpenIdScopeRequired -> (ErrorID "selfhost:oauth-openid-scope", err400 {errBody = "scope must include openid."})
+    where
+      encode = BL.fromStrict . Text.encodeUtf8
+
+-- | https://datatracker.ietf.org/doc/html/rfc6749#section-5.2
+data TokenError
+  = InvalidGrant
+  | InvalidClient
+
+instance Logging.Loggable TokenError where
+  toLog = \case
+    InvalidGrant -> Logging.withSeverity Logging.UserFault $ Logging.textLog "oauth token request with an invalid, expired or used grant"
+    InvalidClient -> Logging.withSeverity Logging.UserFault $ Logging.textLog "oauth token request from an unknown client"
+
+instance ToServerError TokenError where
+  toServerError = \case
+    InvalidGrant -> (ErrorID "selfhost:oauth-invalid-grant", oauthError err400 "invalid_grant")
+    InvalidClient -> (ErrorID "selfhost:oauth-invalid-client", oauthError err401 "invalid_client")
+    where
+      oauthError base code = base {errBody = Aeson.encode (Aeson.object ["error" .= (code :: Text)]), errHeaders = [("Content-Type", "application/json")]}
+
+ucmClientId :: OAuthClientId
+ucmClientId = OAuthClientId "ucm"
+
+server :: ServerT API WebApp
+server =
+  ( loginEndpoint
+      :<|> callbackEndpoint
+      :<|> authorizeEndpoint
+      :<|> tokenEndpoint
+      :<|> userInfoEndpoint
+  )
+    :<|> discoveryEndpoint
+
+brokerConfig :: WebApp OidcConfig
+brokerConfig = asks envSelfHostOidc >>= maybe (respondError BrokerDisabled) pure
+
+apiURL :: [Text] -> WebApp URI
+apiURL segments =
+  asks envApiOrigin <&> \origin ->
+    origin
+      { uriPath = List.dropWhileEnd (== '/') (uriPath origin) <> concatMap (('/' :) . Text.unpack) segments,
+        uriQuery = "",
+        uriFragment = ""
+      }
+
+discoveryEndpoint :: WebApp Aeson.Value
+discoveryEndpoint = do
+  void brokerConfig
+  issuer <- enlilIssuer
+  authorize <- apiURL ["selfhost", "oidc", "authorize"]
+  token <- apiURL ["selfhost", "oidc", "token"]
+  userinfo <- apiURL ["selfhost", "oidc", "userinfo"]
+  jwks <- apiURL [".well-known", "jwks.json"]
+  pure $
+    Aeson.object
+      [ "issuer" .= tshow issuer,
+        "authorization_endpoint" .= tshow authorize,
+        "token_endpoint" .= tshow token,
+        "userinfo_endpoint" .= tshow userinfo,
+        "jwks_uri" .= tshow jwks,
+        "response_types_supported" .= ["code" :: Text],
+        "grant_types_supported" .= ["authorization_code", "refresh_token" :: Text],
+        "code_challenge_methods_supported" .= ["S256" :: Text],
+        "token_endpoint_auth_methods_supported" .= ["none" :: Text],
+        "scopes_supported" .= ["openid", "cloud", "sync" :: Text],
+        "subject_types_supported" .= ["public" :: Text]
+      ]
+
+loginEndpoint :: Maybe URIParam -> WebApp (Headers '[Header "Set-Cookie" Cookies.SetCookie, Header "Location" String] NoContent)
+loginEndpoint returnTo = beginUpstreamLogin LoginPage (unpackURI <$> returnTo)
+
+-- | Sends the browser to the upstream provider, remembering the login in Redis for the callback.
+beginUpstreamLogin :: LoginRequest -> Maybe URI -> WebApp (Headers '[Header "Set-Cookie" Cookies.SetCookie, Header "Location" String] NoContent)
+beginUpstreamLogin loginRequest returnTo = do
+  config <- brokerConfig
+  endpoints <- liftIO (Upstream.resolveEndpoints config) >>= either (respondError . UpstreamFailed) pure
+  (verifier, challenge, _) <- PKCE.generatePkce
+  nonce <- newSecureToken
+  PendingSession {pendingId} <- Redis.liftRedis $ Redis.newPendingSession loginRequest verifier returnTo (Just (Aeson.object ["nonce" .= nonce]))
+  callback <- apiURL ["selfhost", "oidc", "callback"]
+  let target = Upstream.authorizationURI config endpoints callback (IDs.toText pendingId) nonce challenge
+  cookie <- pendingCookie (IDs.toText pendingId)
+  pure $ addHeader cookie (addHeader (show target) NoContent)
+
+-- | Binds the login to the browser that started it, so a callback URL can't be replayed elsewhere.
+pendingCookie :: Text -> WebApp Cookies.SetCookie
+pendingCookie value = do
+  settings <- asks (envCookieSettings . authEnv)
+  pure (Cookies.newSetCookie settings pendingCookieName value) {setCookieMaxAge = Just (5 * 60), setCookiePath = Just "/selfhost/oidc"}
+
+clearPendingCookie :: WebApp Cookies.SetCookie
+clearPendingCookie = do
+  settings <- asks (envCookieSettings . authEnv)
+  pure (Cookies.clearCookie settings pendingCookieName) {setCookiePath = Just "/selfhost/oidc"}
+
+pendingCookieName :: Text
+pendingCookieName = Text.pack (symbolVal (Proxy @PendingCookieName))
+
+callbackEndpoint ::
+  Maybe Text ->
+  Maybe PendingSessionId ->
+  Maybe Text ->
+  Maybe Text ->
+  Maybe (Cookies.CookieVal PendingCookieName PendingSessionId) ->
+  WebApp (Headers '[Header "Set-Cookie" Cookies.SetCookie, Header "Set-Cookie" Cookies.SetCookie, Header "Location" String] NoContent)
+callbackEndpoint code state providerError providerErrorDescription (cookieVal -> cookiePendingId) = do
+  config <- brokerConfig
+  for_ providerError \err -> respondError (ProviderRefused err providerErrorDescription)
+  pendingId <- maybe (respondError MissingPendingSession) pure cookiePendingId
+  when (state /= Just pendingId) $ respondError MismatchedState
+  PendingSession {loginRequest, pkceVerifier, returnToURI, additionalData} <-
+    Redis.liftRedis (Redis.getPendingSession pendingId) >>= maybe (respondError MissingPendingSession) pure
+  Redis.liftRedis (Redis.failPendingSession pendingId)
+  nonce <- case additionalData of
+    Just (Aeson.Object o) | Just (Aeson.String n) <- KeyMap.lookup "nonce" o -> pure n
+    _ -> respondError MissingPendingSession
+  code' <- maybe (respondError (MissingCallbackParam "code")) pure code
+  endpoints <- liftIO (Upstream.resolveEndpoints config) >>= either (respondError . UpstreamFailed) pure
+  callback <- apiURL ["selfhost", "oidc", "callback"]
+  verified <- liftIO do
+    idToken <- Upstream.exchangeCode config endpoints callback code' pkceVerifier
+    either (pure . Left) (Upstream.verifyIdToken config endpoints nonce) idToken
+  identity <- either respondError pure . allowedIdentity config =<< either (respondError . UpstreamFailed) pure verified
+  tier <- asks envSelfHostDefaultTier
+  userId <- postgresM (PG.runTransaction (provisionUser tier identity)) >>= either (respondError . ProvisionFailed) pure
+  session <- sessionCookie userId
+  clear <- clearPendingCookie
+  target <- case loginRequest of
+    LoginPage -> cloudUIReturnTarget returnToURI
+    OAuthRequest authRequest -> codeRedirect userId authRequest
+  pure $ addHeader session (addHeader clear (addHeader (show target) NoContent))
+
+-- | Checks the allowlist like oauth2-proxy does, and picks out the claims provisioning needs.
+allowedIdentity :: OidcConfig -> VerifiedClaims -> Either BrokerError Identity
+allowedIdentity config VerifiedClaims {subject, claims} = do
+  let Allowlist {emails, emailDomains, groups} = config.allowlist
+      email = textClaim config.emailClaim
+      -- An unverified address could be anyone's, so it never matches an email allowlist.
+      verifiedEmail = case KeyMap.lookup "email_verified" claims of
+        Just (Aeson.Bool False) -> Nothing
+        _ -> Text.toLower <$> email
+      emailAllowed =
+        (Set.null emails && Set.null emailDomains) || case verifiedEmail of
+          Just e -> Set.member e emails || Set.member (Text.takeWhileEnd (/= '@') e) emailDomains
+          Nothing -> False
+      userGroups = case KeyMap.lookup (Key.fromText config.groupsClaim) claims of
+        Just (Aeson.Array gs) -> Set.fromList [g | Aeson.String g <- toList gs]
+        Just (Aeson.String g) -> Set.singleton g
+        _ -> Set.empty
+      groupsAllowed = Set.null groups || not (Set.disjoint groups userGroups)
+  unless' (emailAllowed && groupsAllowed) $ NotAllowed (subject <> maybe "" (" " <>) email)
+  pure Identity {issuer = config.issuer, subject, preferredUsername = textClaim config.handleClaim, email}
+  where
+    textClaim name = case KeyMap.lookup (Key.fromText name) claims of
+      Just (Aeson.String t) | not (Text.null t) -> Just t
+      _ -> Nothing
+    unless' ok err = if ok then Right () else Left err
+
+-- | Issues a one-time code for ucm and sends the browser back to ucm's loopback listener.
+codeRedirect :: UserId -> AuthenticationRequest -> WebApp URI
+codeRedirect userId authRequest@AuthenticationRequest {redirectURI = URIParam redirectURI, state} = do
+  iss <- enlilIssuer
+  aud <- enlilAud
+  (_, code) <- Redis.liftRedis $ Redis.createOAuth2Code iss (Set.singleton aud) userId authRequest
+  pure (redirectURI & addQueryParam "state" state & addQueryParam "code" code)
+
+authorizeEndpoint ::
+  ResponseType ->
+  OAuthClientId ->
+  URIParam ->
+  Scopes ->
+  Text ->
+  PKCEChallenge ->
+  PKCEChallengeMethod ->
+  Maybe Session ->
+  WebApp (Headers '[Header "Set-Cookie" Cookies.SetCookie, Header "Location" String] NoContent)
+authorizeEndpoint ResponseTypeCode clientId redirectURI scopes state pkceChallenge pkceChallengeMethod existingSession = do
+  void brokerConfig
+  when (clientId /= ucmClientId) $ respondError (UnknownClient clientId)
+  unless (isLoopback (unpackURI redirectURI)) $ respondError (InvalidRedirectURI redirectURI)
+  case pkceChallengeMethod of
+    SHA256Method -> pure ()
+    PlainTextMethod -> respondError UnsupportedChallengeMethod
+  unless (containsScope OpenId scopes) $ respondError OpenIdScopeRequired
+  let authRequest = AuthenticationRequest {clientId, redirectURI, state, scopes, pkceChallenge, pkceChallengeMethod}
+  case existingSession of
+    Just Session {sessionUserId} -> do
+      target <- codeRedirect sessionUserId authRequest
+      pure $ noHeader (addHeader (show target) NoContent)
+    Nothing -> beginUpstreamLogin (OAuthRequest authRequest) Nothing
+
+-- | RFC 8252 §7.3: native clients listen on a loopback port chosen at runtime.
+isLoopback :: URI -> Bool
+isLoopback URI {uriScheme, uriAuthority, uriFragment} =
+  uriScheme == "http:"
+    && null uriFragment
+    && case uriAuthority of
+      Just URIAuth {uriUserInfo = "", uriRegName} -> uriRegName `elem` ["localhost", "127.0.0.1", "[::1]"]
+      _ -> False
+
+tokenEndpoint :: TokenRequest -> WebApp (Headers '[Header "Cache-Control" String] TokenResponse)
+tokenEndpoint request = do
+  void brokerConfig
+  (userId, sessionId, scope) <- case request of
+    AuthorizationCodeGrant code redirectURI clientId verifier -> do
+      when (clientId /= ucmClientId) $ respondError InvalidClient
+      try (Redis.liftRedis (Redis.exchangeOAuth2Code code clientId redirectURI verifier)) >>= \case
+        Left (_ :: OAuth2Error) -> respondError InvalidGrant
+        Right (sessionId, userId, AuthenticationRequest {scopes}) -> pure (userId, sessionId, scopes)
+    RefreshTokenGrant token ->
+      redeemRefreshToken token >>= \case
+        Nothing -> respondError InvalidGrant
+        Just (userId, scope) -> randomIO <&> \sessionId -> (userId, sessionId, scope)
+  access <- Tokens.accessToken userId sessionId scope
+  refresh <- issueRefreshToken userId scope
+  pure . addHeader "no-store" $
+    TokenResponse
+      { accessToken = ShareJWT.signedJWTToText access,
+        refreshToken = refresh,
+        expiresIn = accessTokenTTL,
+        scope
+      }
+
+userInfoEndpoint :: UserId -> WebApp UserInfo
+userInfoEndpoint userId = do
+  void brokerConfig
+  User {user_name, handle} <- PGO.expectUserById userId
+  pure UserInfo {sub = userId, name = user_name, handle = IDs.toText handle}
