+++ b/src/Cloud/SelfHost/Oidc/RefreshToken.hs
@@ -0,0 +1,65 @@
+-- | Opaque, single-use refresh tokens for ucm, kept in Redis.
+--
+-- Unlike the access tokens these can be revoked: deleting the keys under
+-- @selfhost:oidc:refresh:@ stops every refresh.
+module Cloud.SelfHost.Oidc.RefreshToken
+  ( issueRefreshToken,
+    redeemRefreshToken,
+  )
+where
+
+import Cloud.App (AppM)
+import Cloud.Prelude
+import Cloud.SelfHost.Tokens (accessTokenTTL)
+import Crypto.Hash (SHA256 (..), hashWith)
+import Data.Aeson (FromJSON (..), ToJSON (..), (.:), (.=))
+import Data.Aeson qualified as Aeson
+import Data.ByteString.Char8 qualified as BSC
+import Data.ByteString.Lazy qualified as BL
+import Data.Text.Encoding qualified as Text
+import Database.Redis qualified as R
+import Share.OAuth.Scopes (Scopes)
+import Share.OAuth.Types (UserId)
+import Share.Utils.SecureTokens (newSecureToken)
+
+data Grant = Grant
+  { userId :: UserId,
+    scope :: Scopes
+  }
+
+instance ToJSON Grant where
+  toJSON Grant {userId, scope} = Aeson.object ["user_id" .= userId, "scope" .= scope]
+
+instance FromJSON Grant where
+  parseJSON = Aeson.withObject "Grant" \o -> Grant <$> o .: "user_id" <*> o .: "scope"
+
+newtype RedisFailure = RedisFailure R.Reply
+  deriving stock (Show)
+
+instance Exception RedisFailure
+
+-- | Only a hash is stored, so reading Redis doesn't hand out working tokens.
+redisKey :: Text -> ByteString
+redisKey token = "selfhost:oidc:refresh:" <> BSC.pack (show (hashWith SHA256 (Text.encodeUtf8 token)))
+
+-- | Lives as long as an access token; each refresh replaces it with a new one.
+issueRefreshToken :: UserId -> Scopes -> AppM ctx Text
+issueRefreshToken userId scope = do
+  token <- newSecureToken
+  _ <- orThrow =<< R.setex (redisKey token) (floor accessTokenTTL) (BL.toStrict (Aeson.encode Grant {userId, scope}))
+  pure token
+
+-- | Consumes the token, so a stolen copy stops working once its owner refreshes.
+redeemRefreshToken :: Text -> AppM ctx (Maybe (UserId, Scopes))
+redeemRefreshToken token = do
+  let key = redisKey token
+  stored <- orThrow =<< R.get key
+  deleted <- orThrow =<< R.del [key]
+  pure do
+    -- Of two concurrent redemptions, only the one that deleted the key wins.
+    guard (deleted == 1)
+    Grant {userId, scope} <- stored >>= Aeson.decodeStrict
+    pure (userId, scope)
+
+orThrow :: Either R.Reply a -> AppM ctx a
+orThrow = either (throwIO . RedisFailure) pure
--- a/src/Cloud/SelfHost/Oidc/Upstream.hs
+++ b/src/Cloud/SelfHost/Oidc/Upstream.hs
@@ -0,0 +1,169 @@
+-- | The client side of the OIDC login: cloud-api against the upstream provider.
+module Cloud.SelfHost.Oidc.Upstream
+  ( UpstreamError (..),
+    VerifiedClaims (..),
+    resolveEndpoints,
+    authorizationURI,
+    exchangeCode,
+    verifyIdToken,
+  )
+where
+
+import Cloud.Prelude
+import Cloud.SelfHost.Oidc.Config (Allowlist (..), EndpointSource (..), Endpoints (..), OidcConfig (..))
+import Control.Lens (lens, review, view, (.~))
+import Control.Monad.Except (ExceptT (..), runExceptT, throwError)
+import Crypto.JOSE.JWA.JWS qualified as JWS
+import Crypto.JWT qualified as JWT
+import Data.Aeson (FromJSON (..), (.:))
+import Data.Aeson qualified as Aeson
+import Data.Aeson.KeyMap qualified as KeyMap
+import Data.ByteString.Lazy qualified as BL
+import Data.Maybe (isNothing)
+import Data.Set qualified as Set
+import Data.Text qualified as Text
+import Data.Text.Encoding qualified as Text
+import Network.HTTP.Client qualified as HTTP
+import Network.HTTP.Types (hAccept, statusCode, urlEncode)
+import Network.URI (URI, parseAbsoluteURI)
+import Share.OAuth.Types (PKCEChallenge, PKCEVerifier (..))
+import Share.Utils.URI (addQueryParam)
+
+data UpstreamError
+  = DiscoveryFailed Text
+  | TokenExchangeFailed Text
+  | JWKSFailed Text
+  | InvalidIdToken Text
+  deriving stock (Show)
+
+-- | The claims of an ID token whose signature, issuer, audience, expiry and nonce checked out.
+data VerifiedClaims = VerifiedClaims
+  { subject :: Text,
+    claims :: Aeson.Object
+  }
+
+resolveEndpoints :: OidcConfig -> IO (Either UpstreamError Endpoints)
+resolveEndpoints config@OidcConfig {endpoints} = case endpoints of
+  Fixed fixed -> pure (Right fixed)
+  Discover -> runExceptT do
+    let discoveryURL = Text.dropWhileEnd (== '/') config.issuer <> "/.well-known/openid-configuration"
+    url <- maybe (throwError $ DiscoveryFailed ("invalid discovery URL " <> discoveryURL)) pure (parseAbsoluteURI (Text.unpack discoveryURL))
+    Discovery {discoveredIssuer, discovered} <- ExceptT (first DiscoveryFailed <$> getJSON config.httpManager url)
+    -- OIDC Discovery 1.0 §4.3: the document must name the issuer it was fetched for.
+    when (discoveredIssuer /= config.issuer) $
+      throwError $ DiscoveryFailed ("discovery document names issuer " <> discoveredIssuer <> ", expected " <> config.issuer)
+    pure discovered
+
+authorizationURI :: OidcConfig -> Endpoints -> URI -> Text -> Text -> PKCEChallenge -> URI
+authorizationURI config Endpoints {authorizationEndpoint} redirectURI state nonce challenge =
+  authorizationEndpoint
+    & addQueryParam "response_type" ("code" :: Text)
+    & addQueryParam "client_id" config.clientId
+    & addQueryParam "redirect_uri" (tshow redirectURI)
+    & addQueryParam "scope" scopes
+    & addQueryParam "state" state
+    & addQueryParam "nonce" nonce
+    & addQueryParam "code_challenge" challenge
+    & addQueryParam "code_challenge_method" ("S256" :: Text)
+  where
+    scopes :: Text
+    scopes = Text.unwords $ ["openid", "email", "profile"] <> ["groups" | not (Set.null config.allowlist.groups)]
+
+-- | Redeems an authorization code and returns the raw ID token.
+exchangeCode :: OidcConfig -> Endpoints -> URI -> Text -> PKCEVerifier -> IO (Either UpstreamError Text)
+exchangeCode config Endpoints {tokenEndpoint} redirectURI code (PKCEVerifier verifier) = runExceptT do
+  req <- ExceptT (first TokenExchangeFailed <$> tryHttp (HTTP.requestFromURI tokenEndpoint))
+  let req' =
+        req
+          & HTTP.urlEncodedBody
+            [ ("grant_type", "authorization_code"),
+              ("code", Text.encodeUtf8 code),
+              ("redirect_uri", Text.encodeUtf8 (tshow redirectURI)),
+              ("code_verifier", Text.encodeUtf8 verifier)
+            ]
+          -- RFC 6749 §2.3.1: client_secret_basic form-encodes both halves before base64.
+          & HTTP.applyBasicAuth (urlEncode True (Text.encodeUtf8 config.clientId)) (urlEncode True (Text.encodeUtf8 config.clientSecret))
+          & \r -> r {HTTP.requestHeaders = (hAccept, "application/json") : HTTP.requestHeaders r}
+  resp <- ExceptT (first TokenExchangeFailed <$> tryHttp (HTTP.httpLbs req' config.httpManager))
+  let status = statusCode (HTTP.responseStatus resp)
+  when (status /= 200) $
+    throwError $ TokenExchangeFailed ("token endpoint answered " <> tshow status <> ": " <> Text.decodeUtf8Lenient (BL.toStrict (HTTP.responseBody resp)))
+  TokenResponse idToken <- either (throwError . TokenExchangeFailed . Text.pack) pure (Aeson.eitherDecode (HTTP.responseBody resp))
+  pure idToken
+
+verifyIdToken :: OidcConfig -> Endpoints -> Text -> Text -> IO (Either UpstreamError VerifiedClaims)
+verifyIdToken config Endpoints {jwksURI} expectedNonce idToken = runExceptT do
+  jwks :: JWT.JWKSet <- ExceptT (first JWKSFailed <$> getJSON config.httpManager jwksURI)
+  IdTokenClaims {registered, claims} <-
+    ExceptT . fmap (first (InvalidIdToken . tshow)) . runExceptT @JWT.JWTError $ do
+      jwt <- JWT.decodeCompact (BL.fromStrict (Text.encodeUtf8 idToken))
+      JWT.verifyJWT validation jwks jwt
+  -- jose only validates the registered claims that are present; OIDC Core §2 requires these.
+  subject <- maybe (throwError $ InvalidIdToken "no sub claim") (pure . review JWT.stringOrUri) (view JWT.claimSub registered)
+  when (isNothing (view JWT.claimExp registered)) $ throwError (InvalidIdToken "no exp claim")
+  when (isNothing (view JWT.claimIss registered)) $ throwError (InvalidIdToken "no iss claim")
+  when (isNothing (view JWT.claimAud registered)) $ throwError (InvalidIdToken "no aud claim")
+  when (KeyMap.lookup "nonce" claims /= Just (Aeson.String expectedNonce)) $
+    throwError (InvalidIdToken "nonce mismatch")
+  -- OIDC Core §3.1.3.7: azp, when present, must be this client.
+  case KeyMap.lookup "azp" claims of
+    Nothing -> pure ()
+    Just (Aeson.String azp) | azp == config.clientId -> pure ()
+    Just other -> throwError (InvalidIdToken ("azp is " <> tshow other))
+  pure VerifiedClaims {subject, claims}
+  where
+    validation =
+      JWT.defaultJWTValidationSettings (matches config.clientId)
+        & JWT.issuerPredicate .~ matches config.issuer
+        & JWT.allowedSkew .~ 60
+        & JWT.validationSettings
+          .~ ( JWT.defaultValidationSettings
+                 -- Only asymmetric algorithms, so a token can't be forged by HMAC-signing it with a public key.
+                 & JWT.validationSettingsAlgorithms
+                   .~ Set.fromList [JWS.RS256, JWS.RS384, JWS.RS512, JWS.PS256, JWS.PS384, JWS.PS512, JWS.ES256, JWS.ES384, JWS.ES512, JWS.EdDSA]
+             )
+    matches :: Text -> JWT.StringOrURI -> Bool
+    matches expected actual = review JWT.stringOrUri actual == expected
+
+data Discovery = Discovery
+  { discoveredIssuer :: Text,
+    discovered :: Endpoints
+  }
+
+instance FromJSON Discovery where
+  parseJSON = Aeson.withObject "openid-configuration" \o -> do
+    discoveredIssuer <- o .: "issuer"
+    authorizationEndpoint <- o .: "authorization_endpoint" >>= parseURL
+    tokenEndpoint <- o .: "token_endpoint" >>= parseURL
+    jwksURI <- o .: "jwks_uri" >>= parseURL
+    pure Discovery {discoveredIssuer, discovered = Endpoints {..}}
+    where
+      parseURL txt = maybe (fail ("not an absolute URL: " <> Text.unpack txt)) pure (parseAbsoluteURI (Text.unpack txt))
+
+newtype TokenResponse = TokenResponse Text
+
+instance FromJSON TokenResponse where
+  parseJSON = Aeson.withObject "token response" \o -> TokenResponse <$> o .: "id_token"
+
+-- | An ID token's registered claims, plus the whole object for the rest.
+data IdTokenClaims = IdTokenClaims
+  { registered :: JWT.ClaimsSet,
+    claims :: Aeson.Object
+  }
+
+instance JWT.HasClaimsSet IdTokenClaims where
+  claimsSet = lens (.registered) \c registered -> c {registered}
+
+instance FromJSON IdTokenClaims where
+  parseJSON = Aeson.withObject "ID token claims" \o -> IdTokenClaims <$> parseJSON (Aeson.Object o) <*> pure o
+
+getJSON :: (FromJSON a) => HTTP.Manager -> URI -> IO (Either Text a)
+getJSON manager url = runExceptT do
+  req <- ExceptT (tryHttp (HTTP.requestFromURI url))
+  resp <- ExceptT (tryHttp (HTTP.httpLbs req {HTTP.requestHeaders = [(hAccept, "application/json")]} manager))
+  let status = statusCode (HTTP.responseStatus resp)
+  when (status /= 200) $ throwError (tshow url <> " answered " <> tshow status)
+  either (throwError . (\err -> tshow url <> ": " <> Text.pack err)) pure (Aeson.eitherDecode (HTTP.responseBody resp))
+
+tryHttp :: IO a -> IO (Either Text a)
+tryHttp action = first (tshow @HTTP.HttpException) <$> try action
