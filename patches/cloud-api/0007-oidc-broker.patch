+{-# LANGUAGE DataKinds #-}
+{-# LANGUAGE TypeOperators #-}
+
+module Cloud.SelfHost.Oidc.API
+  ( API,
+    PendingCookieName,
+    TokenRequest (..),
+    TokenResponse (..),
+    UserInfo (..),
+  )
+where
+
+import Cloud.Prelude
+import Data.Aeson (ToJSON (..), (.=))
+import Data.Aeson qualified as Aeson
+import Data.Time (NominalDiffTime)
+import Servant
+import Share.OAuth.API (AuthorizationEndpoint)
+import Share.OAuth.Scopes (Scopes)
+import Share.OAuth.Session (AuthenticatedUserId)
+import Share.OAuth.Types (Code, OAuthClientId, PendingSessionId, PKCEVerifier, UserId)
+import Share.Utils.Servant.Cookies qualified as Cookies
+import Share.Utils.URI (URIParam)
+import Web.FormUrlEncoded (FromForm (..))
+import Web.FormUrlEncoded qualified as Form
+
+type PendingCookieName = "selfhost-oidc-pending"
+
+-- | The paths are free: ucm finds the authorization server's endpoints through the
+-- discovery document, and the web UI's /login is rewritten to the login endpoint.
+type API =
+  ( "selfhost"
+      :> "oidc"
+      :> ( ("login" :> LoginEndpoint)
+             :<|> ("callback" :> CallbackEndpoint)
+             :<|> ("authorize" :> AuthorizationEndpoint)
+             :<|> ("token" :> TokenEndpoint)
+             :<|> ("userinfo" :> UserInfoEndpoint)
+         )
+  )
+    :<|> (".well-known" :> "openid-configuration" :> Get '[JSON] Aeson.Value)
+
+-- | GET /selfhost/oidc/login
+-- Logs in through the upstream provider, then sets the session cookie and redirects to the cloud UI.
+type LoginEndpoint =
+  QueryParam "return_to" URIParam
+    :> Verb 'GET 302 '[PlainText] (Headers '[Header "Set-Cookie" Cookies.SetCookie, Header "Location" String] NoContent)
+
+-- | GET /selfhost/oidc/callback
+-- The upstream provider's redirect URI.
+type CallbackEndpoint =
+  QueryParam "code" Text
+    :> QueryParam "state" PendingSessionId
+    :> QueryParam "error" Text
+    :> QueryParam "error_description" Text
+    :> Cookies.Cookie PendingCookieName PendingSessionId
+    :> Verb 'GET 302 '[PlainText] (Headers '[Header "Set-Cookie" Cookies.SetCookie, Header "Set-Cookie" Cookies.SetCookie, Header "Location" String] NoContent)
+
+-- | POST /selfhost/oidc/token
+type TokenEndpoint =
+  ReqBody '[FormUrlEncoded] TokenRequest
+    :> Post '[JSON] (Headers '[Header "Cache-Control" String] TokenResponse)
+
+-- | GET /selfhost/oidc/userinfo
+type UserInfoEndpoint =
+  AuthenticatedUserId :> Get '[JSON] UserInfo
+
+-- | https://datatracker.ietf.org/doc/html/rfc6749#section-4.1.3 and #section-6.
+-- ucm sends no client_id when refreshing.
+data TokenRequest
+  = AuthorizationCodeGrant Code URIParam OAuthClientId PKCEVerifier
+  | RefreshTokenGrant Text
+
+instance FromForm TokenRequest where
+  fromForm form =
+    Form.parseUnique @Text "grant_type" form >>= \case
+      "authorization_code" ->
+        AuthorizationCodeGrant
+          <$> Form.parseUnique "code" form
+          <*> Form.parseUnique "redirect_uri" form
+          <*> Form.parseUnique "client_id" form
+          <*> Form.parseUnique "code_verifier" form
+      "refresh_token" -> RefreshTokenGrant <$> Form.parseUnique "refresh_token" form
+      other -> Left ("unsupported grant_type " <> other)
+
+-- | ucm requires refresh_token and scope, and reads expires_in to decide when to log in again.
+data TokenResponse = TokenResponse
+  { accessToken :: Text,
+    refreshToken :: Text,
+    expiresIn :: NominalDiffTime,
+    scope :: Scopes
+  }
+
+instance ToJSON TokenResponse where
+  toJSON TokenResponse {accessToken, refreshToken, expiresIn, scope} =
+    Aeson.object
+      [ "access_token" .= accessToken,
+        "token_type" .= ("bearer" :: Text),
+        "expires_in" .= (floor expiresIn :: Integer),
+        "refresh_token" .= refreshToken,
+        "scope" .= scope
+      ]
+
+-- | ucm requires sub and handle; name is optional.
+data UserInfo = UserInfo
+  { sub :: UserId,
+    name :: Maybe Text,
+    handle :: Text
+  }
+
+instance ToJSON UserInfo where
+  toJSON UserInfo {sub, name, handle} =
+    Aeson.object ["sub" .= sub, "name" .= name, "handle" .= handle]
