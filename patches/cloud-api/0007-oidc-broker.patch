+-- | Configuration of the upstream OIDC provider cloud-api brokers logins through.
+module Cloud.SelfHost.Oidc.Config
+  ( OidcConfig (..),
+    Endpoints (..),
+    EndpointSource (..),
+    Allowlist (..),
+    loadOidcConfig,
+  )
+where
+
+import Cloud.Prelude
+import Data.Set (Set)
+import Data.Set qualified as Set
+import Data.Text qualified as Text
+import Network.HTTP.Client (Manager)
+import Network.URI (URI, parseAbsoluteURI, uriScheme)
+import System.Environment (lookupEnv)
+
+data OidcConfig = OidcConfig
+  { -- | Compared verbatim with the ID token's @iss@, and recorded with each identity.
+    issuer :: Text,
+    endpoints :: EndpointSource,
+    clientId :: Text,
+    clientSecret :: Text,
+    handleClaim :: Text,
+    emailClaim :: Text,
+    groupsClaim :: Text,
+    allowlist :: Allowlist,
+    httpManager :: Manager
+  }
+
+data Endpoints = Endpoints
+  { authorizationEndpoint :: URI,
+    tokenEndpoint :: URI,
+    jwksURI :: URI
+  }
+
+data EndpointSource
+  = Discover
+  | -- | The issuer's public URL isn't always reachable from cloud-api's network, so the
+    -- server-to-server endpoints can point somewhere else.
+    Fixed Endpoints
+
+-- | Like oauth2-proxy: the email has to match one of the email lists if either is set, and
+-- the groups one of the groups if that is set.
+data Allowlist = Allowlist
+  { emails :: Set Text,
+    emailDomains :: Set Text,
+    groups :: Set Text
+  }
+
+-- | Nothing unless @CLOUD_OIDC_ISSUER@ is set, which leaves the broker disabled.
+loadOidcConfig :: Manager -> IO (Either String (Maybe OidcConfig))
+loadOidcConfig httpManager =
+  lookupEnv "CLOUD_OIDC_ISSUER" >>= \case
+    Nothing -> pure (Right Nothing)
+    Just issuerStr -> do
+      clientId <- lookupEnv "CLOUD_OIDC_CLIENT_ID"
+      clientSecret <- lookupEnv "CLOUD_OIDC_CLIENT_SECRET"
+      authorizationURL <- lookupEnv "CLOUD_OIDC_AUTHORIZATION_URL"
+      tokenURL <- lookupEnv "CLOUD_OIDC_TOKEN_URL"
+      jwksURL <- lookupEnv "CLOUD_OIDC_JWKS_URL"
+      handleClaim <- lookupEnv "CLOUD_OIDC_HANDLE_CLAIM"
+      emailClaim <- lookupEnv "CLOUD_OIDC_EMAIL_CLAIM"
+      groupsClaim <- lookupEnv "CLOUD_OIDC_GROUPS_CLAIM"
+      allowedEmails <- lookupEnv "CLOUD_OIDC_ALLOWED_EMAILS"
+      allowedEmailDomains <- lookupEnv "CLOUD_OIDC_ALLOWED_EMAIL_DOMAINS"
+      allowedGroups <- lookupEnv "CLOUD_OIDC_ALLOWED_GROUPS"
+      pure $ fmap Just do
+        _ <- parseURL "CLOUD_OIDC_ISSUER" issuerStr
+        endpoints <- case (authorizationURL, tokenURL, jwksURL) of
+          (Nothing, Nothing, Nothing) -> Right Discover
+          (Just a, Just t, Just j) ->
+            Fixed <$> (Endpoints <$> parseURL "CLOUD_OIDC_AUTHORIZATION_URL" a <*> parseURL "CLOUD_OIDC_TOKEN_URL" t <*> parseURL "CLOUD_OIDC_JWKS_URL" j)
+          _ -> Left "CLOUD_OIDC_AUTHORIZATION_URL, CLOUD_OIDC_TOKEN_URL and CLOUD_OIDC_JWKS_URL must be set together"
+        clientId' <- required "CLOUD_OIDC_CLIENT_ID" clientId
+        clientSecret' <- required "CLOUD_OIDC_CLIENT_SECRET" clientSecret
+        pure
+          OidcConfig
+            { issuer = Text.pack issuerStr,
+              endpoints,
+              clientId = clientId',
+              clientSecret = clientSecret',
+              handleClaim = maybe "preferred_username" Text.pack handleClaim,
+              emailClaim = maybe "email" Text.pack emailClaim,
+              groupsClaim = maybe "groups" Text.pack groupsClaim,
+              allowlist =
+                Allowlist
+                  { emails = Set.map Text.toLower (commaSeparated allowedEmails),
+                    emailDomains = Set.map Text.toLower (commaSeparated allowedEmailDomains),
+                    groups = commaSeparated allowedGroups
+                  },
+              httpManager
+            }
+  where
+    required var = maybe (Left (var <> " must be set when CLOUD_OIDC_ISSUER is")) (Right . Text.pack)
+
+    parseURL var str = case parseAbsoluteURI str of
+      Just uri | uriScheme uri `elem` ["http:", "https:"] -> Right uri
+      _ -> Left (var <> " must be an absolute http or https URL, got " <> str)
+
+    commaSeparated =
+      maybe Set.empty (Set.fromList . filter (not . Text.null) . map Text.strip . Text.splitOn "," . Text.pack)
