+-- | Session cookies and access tokens for self-hosted logins.
+module Cloud.SelfHost.Tokens
+  ( TokenError (..),
+    accessTokenTTL,
+    sessionCookie,
+    accessToken,
+    cloudUIReturnTarget,
+  )
+where
+
+import Cloud.Env (Env (..))
+import Cloud.Errors (ErrorID (..), ToServerError (..), respondError)
+import Cloud.Prelude
+import Cloud.User.App (authM)
+import Cloud.User.Env (AuthEnv (..))
+import Cloud.User.Impl (enlilAud, enlilIssuer)
+import Cloud.Utils.Logging qualified as Logging
+import Cloud.Web.App (WebApp, isCloudUILink)
+import Cloud.Web.Local.Impl (AccessTokenClaims (..), newStandardClaims, signJWT)
+import Control.Monad.Reader (ask, asks)
+import Crypto.JWT (SignedJWT)
+import Data.Set qualified as Set
+import Data.Time (NominalDiffTime, addUTCTime, nominalDay)
+import Network.URI (URI)
+import Servant (err500)
+import Share.JWT qualified as ShareJWT
+import Share.OAuth.Scopes (Scopes)
+import Share.OAuth.Session (Session (..))
+import Share.OAuth.Session qualified as Session
+import Share.OAuth.Types (SessionId, UserId)
+import Share.Utils.Servant.Cookies qualified as Cookies
+
+newtype TokenError = SigningFailed Text
+
+instance Logging.Loggable TokenError where
+  toLog (SigningFailed err) = Logging.withSeverity Logging.Error . Logging.textLog $ "selfhost login failed to sign a token: " <> err
+
+instance ToServerError TokenError where
+  toServerError SigningFailed {} = (ErrorID "selfhost:signing-failed", err500)
+
+-- | Shorter than the 300 days of the local-only tokens, since tokens can't be revoked.
+accessTokenTTL :: NominalDiffTime
+accessTokenTTL = 30 * nominalDay
+
+sessionCookie :: UserId -> WebApp Cookies.SetCookie
+sessionCookie userId = do
+  iss <- enlilIssuer
+  aud <- enlilAud
+  session <- Session.createSession iss (Set.singleton aud) userId
+  -- share-auth's sessions last a year; bound the cookie's JWT like the access tokens.
+  let session' = session {sessionExpiry = addUTCTime accessTokenTTL (sessionCreated session)}
+  cookie <- authM do
+    AuthEnv {envSessionCookieName, envCookieSettings, envJwtSettings} <- ask
+    ShareJWT.createSignedCookie envJwtSettings envCookieSettings envSessionCookieName session'
+  either (respondError . SigningFailed . tshow) pure cookie
+
+accessToken :: UserId -> SessionId -> Scopes -> WebApp SignedJWT
+accessToken userId sessionId scope = do
+  aud <- enlilAud
+  standardClaims <- newStandardClaims aud userId accessTokenTTL sessionId
+  signJWT AccessTokenClaims {standardClaims, scope}
+
+-- | Like the Share login callback, only return to the cloud UI, never an arbitrary site.
+cloudUIReturnTarget :: Maybe URI -> WebApp URI
+cloudUIReturnTarget returnTo = do
+  uiOrigin <- asks envCloudUiOrigin
+  case returnTo of
+    Just uri -> isCloudUILink uri <&> \valid -> if valid then uri else uiOrigin
+    Nothing -> pure uiOrigin
