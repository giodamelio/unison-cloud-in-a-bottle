+-- | The subset of the Vault KV v2 HTTP API that nimbus uses for environment secrets,
+-- served from Postgres so the stack runs without Vault.
+module Cloud.SelfHost.Secrets.Listener
+  ( runSecretsListener,
+  )
+where
+
+import Cloud.App (runAppM)
+import Cloud.Byoc.Env (ClusterConfig (..), ClusterToken (..))
+import Cloud.Env (Env (..))
+import Cloud.Postgres qualified as PG
+import Cloud.Postgres.App (postgresM)
+import Cloud.Postgres.Queries.BYOC qualified as BYOC
+import Cloud.Prelude
+import Cloud.SelfHost.Secrets.Queries (SecretVersion)
+import Cloud.SelfHost.Secrets.Queries qualified as Q
+import Cloud.Web.Types (EnvironmentId (..))
+import Data.Aeson ((.:), (.:?), (.=))
+import Data.Aeson qualified as JS
+import Data.ByteString.Lazy qualified as BL
+import Data.String (fromString)
+import Data.Text.Encoding qualified as Text
+import Data.UUID qualified as UUID
+import Data.Void (Void)
+import Network.HTTP.Types qualified as HTTP
+import Network.Wai qualified as Wai
+import Network.Wai.Handler.Warp qualified as Warp
+
+runSecretsListener :: Env () -> IO ()
+runSecretsListener env =
+  Warp.runSettings settings (secretsApp env)
+  where
+    settings =
+      Warp.defaultSettings
+        & Warp.setHost (fromString (envSecretsHost env))
+        & Warp.setPort (envSecretsPort env)
+
+data WriteRequest = WriteRequest (Maybe SecretVersion) (Map Text Text)
+
+instance JS.FromJSON WriteRequest where
+  parseJSON = JS.withObject "WriteRequest" \o -> do
+    options <- o .:? "options"
+    cas <- maybe (pure Nothing) (.:? "cas") options
+    secretData <- o .: "data"
+    pure (WriteRequest cas secretData)
+
+newtype PatchRequest = PatchRequest (Map Text (Maybe Text))
+
+instance JS.FromJSON PatchRequest where
+  parseJSON = JS.withObject "PatchRequest" \o -> PatchRequest <$> o .: "data"
+
+secretsApp :: Env () -> Wai.Application
+secretsApp env req respond = do
+  body <- Wai.strictRequestBody req
+  response <- case Wai.pathInfo req of
+    ["v1", mount, kind, rawId]
+      | mount /= envEnvironmentsMount env -> pure $ vaultError HTTP.status404 ("unknown mount: " <> mount)
+      | Just uuid <- UUID.fromText rawId -> route kind (EnvironmentId uuid) body
+      | otherwise -> pure $ vaultError HTTP.status404 ("not an environment id: " <> rawId)
+    _ -> pure $ vaultError HTTP.status404 "unsupported path"
+  respond response
+  where
+    route :: Text -> EnvironmentId -> BL.ByteString -> IO Wai.Response
+    route kind envId body = case (Wai.requestMethod req, kind) of
+      ("GET", "data") -> authorized envId $ Q.fetchSecret envId <&> \case
+        Nothing -> vaultError HTTP.status404 "secret not found"
+        Just (secretData, version) ->
+          jsonResponse HTTP.status200 $
+            JS.object ["data" .= JS.object ["data" .= secretData, "metadata" .= JS.object ["version" .= version]]]
+      -- Real Vault answers this route with KV metadata, but nimbus's
+      -- environment.fetchVersion decodes {data: {data}, version}, so serve that.
+      ("GET", "metadata") -> authorized envId $ Q.fetchSecret envId <&> \case
+        Nothing -> vaultError HTTP.status404 "secret not found"
+        Just (secretData, version) ->
+          jsonResponse HTTP.status200 $
+            JS.object ["data" .= JS.object ["data" .= secretData], "version" .= version]
+      (method, "data") | method `elem` ["POST", "PUT"] -> withBody body \(WriteRequest cas secretData) ->
+        authorized envId $ versionResponse <$> case cas of
+          Nothing -> Just <$> Q.writeSecret envId secretData
+          Just 0 -> Q.createSecret envId secretData
+          Just expected -> Q.checkAndSetSecret envId expected secretData
+      ("PATCH", "data") -> withBody body \(PatchRequest patch) ->
+        authorized envId $ Q.patchSecret envId patch <&> \case
+          Nothing -> vaultError HTTP.status404 "secret not found"
+          Just version -> jsonResponse HTTP.status200 (versionBody version)
+      ("DELETE", "data") ->
+        authorized envId $ Q.deleteSecret envId $> Wai.responseLBS HTTP.status204 [] ""
+      _ -> pure $ vaultError HTTP.status405 "unsupported method"
+
+    versionResponse :: Maybe SecretVersion -> Wai.Response
+    versionResponse = \case
+      Nothing -> vaultError HTTP.status400 "check-and-set parameter did not match the current version"
+      Just version -> jsonResponse HTTP.status200 (versionBody version)
+
+    versionBody :: SecretVersion -> JS.Value
+    versionBody version = JS.object ["data" .= JS.object ["version" .= version]]
+
+    withBody :: (JS.FromJSON a) => BL.ByteString -> (a -> IO Wai.Response) -> IO Wai.Response
+    withBody body k = case JS.eitherDecode body of
+      Left err -> pure $ vaultError HTTP.status400 ("invalid request body: " <> fromString err)
+      Right a -> k a
+
+    -- The token is a cluster token, and it only reaches environments of its own cluster.
+    authorized :: EnvironmentId -> PG.Transaction Void Wai.Response -> IO Wai.Response
+    authorized envId tx =
+      case lookup "X-Vault-Token" (Wai.requestHeaders req) >>= eitherToMaybe . Text.decodeUtf8' of
+        Nothing -> pure permissionDenied
+        Just token -> runAppM env . postgresM . PG.runTransaction $ do
+          tokenCluster <- BYOC.clusterConfigByToken (ClusterToken token)
+          envCluster <- Q.environmentClusterId envId
+          case (tokenCluster, envCluster) of
+            (Just ClusterConfig {clusterId}, Just envClusterId) | clusterId == envClusterId -> tx
+            _ -> pure permissionDenied
+
+    permissionDenied :: Wai.Response
+    permissionDenied = vaultError HTTP.status403 "permission denied"
+
+vaultError :: HTTP.Status -> Text -> Wai.Response
+vaultError status msg = jsonResponse status (JS.object ["errors" .= [msg]])
+
+jsonResponse :: HTTP.Status -> JS.Value -> Wai.Response
+jsonResponse status = Wai.responseLBS status [(HTTP.hContentType, "application/json")] . JS.encode
