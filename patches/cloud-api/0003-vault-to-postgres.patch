+CREATE SCHEMA IF NOT EXISTS selfhost;
+
+-- Replaces the Vault KV v2 mount that held one secret per environment.
+CREATE TABLE selfhost.environment_secrets (
+  environment_id uuid PRIMARY KEY REFERENCES public.cloud_environments (id) ON DELETE CASCADE,
+  -- Always a JSON object of string values: nimbus decodes it as a text map.
+  data jsonb NOT NULL DEFAULT '{}' CHECK (jsonb_typeof(data) = 'object'),
+  version integer NOT NULL DEFAULT 1,
+  updated_at timestamptz NOT NULL DEFAULT now()
+);
