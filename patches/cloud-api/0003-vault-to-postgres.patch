@@ -0,0 +1,95 @@
+module Cloud.SelfHost.Secrets.Queries
+  ( SecretVersion,
+    environmentClusterId,
+    fetchSecret,
+    createSecret,
+    writeSecret,
+    checkAndSetSecret,
+    patchSecret,
+    deleteSecret,
+  )
+where
+
+import Cloud.Byoc.Env (ClusterId)
+import Cloud.Postgres qualified as PG
+import Cloud.Prelude
+import Cloud.Web.Types (EnvironmentId)
+import Data.Int (Int32)
+import Hasql.Interpolate (AsJsonb (..))
+
+type SecretVersion = Int32
+
+environmentClusterId :: EnvironmentId -> PG.Transaction e (Maybe ClusterId)
+environmentClusterId envId =
+  PG.query1Col
+    [PG.sql|
+        SELECT cluster_id FROM cloud_environments WHERE id = #{envId}
+      |]
+
+fetchSecret :: EnvironmentId -> PG.Transaction e (Maybe (Map Text Text, SecretVersion))
+fetchSecret envId = do
+  row <-
+    PG.query1Row
+      [PG.sql|
+          SELECT data, version FROM selfhost.environment_secrets
+            WHERE environment_id = #{envId}
+        |]
+  pure $ row <&> \(AsJsonb secretData, version) -> (secretData, version)
+
+-- | Inserts the secret unless one exists. Returns 'Nothing' if it already existed.
+createSecret :: EnvironmentId -> Map Text Text -> PG.Transaction e (Maybe SecretVersion)
+createSecret envId secretData = do
+  let json = AsJsonb secretData
+  PG.query1Col
+    [PG.sql|
+        INSERT INTO selfhost.environment_secrets (environment_id, data)
+          VALUES (#{envId}, #{json})
+          ON CONFLICT (environment_id) DO NOTHING
+          RETURNING version
+      |]
+
+writeSecret :: EnvironmentId -> Map Text Text -> PG.Transaction e SecretVersion
+writeSecret envId secretData = do
+  let json = AsJsonb secretData
+  PG.queryExpect1Col
+    [PG.sql|
+        INSERT INTO selfhost.environment_secrets (environment_id, data)
+          VALUES (#{envId}, #{json})
+          ON CONFLICT (environment_id) DO UPDATE
+            SET data = EXCLUDED.data,
+                version = selfhost.environment_secrets.version + 1,
+                updated_at = now()
+          RETURNING version
+      |]
+
+-- | Replaces the secret only if its current version matches. Returns 'Nothing' otherwise.
+checkAndSetSecret :: EnvironmentId -> SecretVersion -> Map Text Text -> PG.Transaction e (Maybe SecretVersion)
+checkAndSetSecret envId expectedVersion secretData = do
+  let json = AsJsonb secretData
+  PG.query1Col
+    [PG.sql|
+        UPDATE selfhost.environment_secrets
+          SET data = #{json}, version = version + 1, updated_at = now()
+          WHERE environment_id = #{envId} AND version = #{expectedVersion}
+          RETURNING version
+      |]
+
+-- | JSON merge-patch: a 'Nothing' value removes the key. Returns 'Nothing' if there's no secret.
+patchSecret :: EnvironmentId -> Map Text (Maybe Text) -> PG.Transaction e (Maybe SecretVersion)
+patchSecret envId patch = do
+  let json = AsJsonb patch
+  -- Stored values are always strings, so stripping nulls only removes the patched-out keys.
+  PG.query1Col
+    [PG.sql|
+        UPDATE selfhost.environment_secrets
+          SET data = jsonb_strip_nulls(data || #{json}), version = version + 1, updated_at = now()
+          WHERE environment_id = #{envId}
+          RETURNING version
+      |]
+
+deleteSecret :: EnvironmentId -> PG.Transaction e ()
+deleteSecret envId =
+  PG.execute_
+    [PG.sql|
+        DELETE FROM selfhost.environment_secrets WHERE environment_id = #{envId}
+      |]
