+-- | The pending logins and authorization codes of share-auth's "Share.OAuth.Redis", kept
+-- in 'Ephemeral' instead. Values keep share-auth's 'Binary' encodings and key names.
+module Cloud.SelfHost.Oidc.OAuthState
+  ( newPendingSession,
+    getPendingSession,
+    failPendingSession,
+    createOAuth2Code,
+    exchangeOAuth2Code,
+  )
+where
+
+import Cloud.App (AppM)
+import Cloud.Postgres qualified as PG
+import Cloud.Postgres.App (postgresM)
+import Cloud.Prelude
+import Cloud.SelfHost.Ephemeral qualified as Ephemeral
+import Data.Aeson ((.:), (.=))
+import Data.Aeson qualified as Aeson
+import Data.Binary (Binary)
+import Data.Binary qualified as Binary
+import Data.ByteString.Lazy qualified as BL
+import Data.Set (Set)
+import Data.Time (NominalDiffTime)
+import Data.Typeable (Proxy (..), TypeRep, Typeable, typeRep)
+import Network.URI (URI)
+import Share.OAuth.Errors (OAuth2Error (..))
+import Share.OAuth.PKCE (verifyPkce)
+import Share.OAuth.Session (LoginRequest, PendingSession (..), Session (..))
+import Share.OAuth.Session qualified as Session
+import Share.OAuth.Types (AuthenticationRequest (..), Code (..), OAuthClientId, PKCEVerifier, PendingSessionId (..), SessionId, UserId)
+import Share.Utils.Binary (JSONBinary (..))
+import Share.Utils.IDs qualified as IDs
+import Share.Utils.SecureTokens (newSecureToken)
+import Share.Utils.URI (URIParam)
+
+-- | A stored value no longer decodes, likely because its encoding changed incompatibly.
+data DecodingError = DecodingError Text String TypeRep
+  deriving stock (Show)
+
+instance Exception DecodingError
+
+pendingSessionTTL :: NominalDiffTime
+pendingSessionTTL = 5 * 60
+
+codeTTL :: NominalDiffTime
+codeTTL = 5 * 60
+
+pendingSessionKey :: PendingSessionId -> Text
+pendingSessionKey sid = "sessions:pending:" <> IDs.toText sid
+
+codeKey :: Code -> Text
+codeKey code = "oauthcode:" <> codeText code
+
+newPendingSession :: LoginRequest -> PKCEVerifier -> Maybe URI -> Maybe Aeson.Value -> AppM ctx PendingSession
+newPendingSession loginRequest pkceVerifier returnToURI additionalData = do
+  pendingId <- PendingSessionId <$> newSecureToken
+  let pending = PendingSession {pendingId, loginRequest, pkceVerifier, returnToURI, additionalData}
+  postgresM . PG.runTransaction $ Ephemeral.put (pendingSessionKey pendingId) pendingSessionTTL (encode pending)
+  pure pending
+
+getPendingSession :: PendingSessionId -> AppM ctx (Maybe PendingSession)
+getPendingSession sid = do
+  let key = pendingSessionKey sid
+  postgresM (PG.runTransaction (Ephemeral.get key)) >>= traverse (decode key)
+
+failPendingSession :: PendingSessionId -> AppM ctx ()
+failPendingSession sid = void . postgresM . PG.runTransaction $ Ephemeral.take (pendingSessionKey sid)
+
+data CodeExchange = CodeExchange
+  { code :: Code,
+    authRequest :: AuthenticationRequest,
+    userId :: UserId,
+    sessionId :: SessionId
+  }
+  deriving (Binary) via JSONBinary CodeExchange
+
+instance Aeson.ToJSON CodeExchange where
+  toJSON CodeExchange {code, authRequest, userId, sessionId} =
+    Aeson.object
+      [ "code" .= code,
+        "auth_request" .= authRequest,
+        "user_id" .= userId,
+        "session_id" .= sessionId
+      ]
+
+instance Aeson.FromJSON CodeExchange where
+  parseJSON = Aeson.withObject "CodeExchange" \o ->
+    CodeExchange <$> o .: "code" <*> o .: "auth_request" <*> o .: "user_id" <*> o .: "session_id"
+
+createOAuth2Code :: URI -> Set URI -> UserId -> AuthenticationRequest -> AppM ctx (Session, Code)
+createOAuth2Code issuer aud userId authRequest = do
+  code <- Code <$> newSecureToken
+  session@Session {sessionId} <- Session.createSession issuer aud userId
+  postgresM . PG.runTransaction $ Ephemeral.put (codeKey code) codeTTL (encode CodeExchange {code, authRequest, userId, sessionId})
+  pure (session, code)
+
+-- | Consumes the code before checking it, so it's redeemed at most once even when two
+-- exchanges race, and a failed attempt burns it.
+exchangeOAuth2Code :: Code -> OAuthClientId -> URIParam -> PKCEVerifier -> AppM ctx (SessionId, UserId, AuthenticationRequest)
+exchangeOAuth2Code code callerClientId callerRedirectURI verifier = do
+  let key = codeKey code
+  postgresM (PG.runTransaction (Ephemeral.take key)) >>= traverse (decode key) >>= \case
+    Nothing -> throwIO (CodeMissingOrExpired code)
+    Just CodeExchange {userId, sessionId, authRequest = authRequest@AuthenticationRequest {clientId, redirectURI, pkceChallenge, pkceChallengeMethod}}
+      | clientId /= callerClientId -> throwIO (MismatchedClientId callerClientId clientId)
+      | redirectURI /= callerRedirectURI -> throwIO (MismatchedRedirectURI callerRedirectURI redirectURI)
+      | not (verifyPkce verifier pkceChallenge pkceChallengeMethod) -> throwIO PKCEChallengeFailure
+      | otherwise -> pure (sessionId, userId, authRequest)
+
+encode :: (Binary a) => a -> ByteString
+encode = BL.toStrict . Binary.encode
+
+decode :: forall a ctx. (Typeable a, Binary a) => Text -> ByteString -> AppM ctx a
+decode key bytes = case Binary.decodeOrFail (BL.fromStrict bytes) of
+  Left (_, _, err) -> throwIO (DecodingError key err (typeRep (Proxy @a)))
+  Right (_, _, a) -> pure a
