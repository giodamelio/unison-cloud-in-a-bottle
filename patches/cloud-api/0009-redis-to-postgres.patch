+CREATE SCHEMA IF NOT EXISTS selfhost;
+
+-- Replaces Redis for login state, authorization codes and refresh tokens. Readers
+-- ignore expired rows and writers delete them, so nothing needs to run on a timer.
+CREATE TABLE selfhost.ephemeral (
+  key text PRIMARY KEY,
+  value bytea NOT NULL,
+  expires_at timestamptz NOT NULL
+);
