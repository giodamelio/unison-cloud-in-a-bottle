--- a/src/Cloud/SelfHost/Ephemeral.hs
+++ b/src/Cloud/SelfHost/Ephemeral.hs
@@ -0,0 +1,47 @@
+-- | Short-lived values with an expiry, kept in Postgres so the stack runs without Redis.
+--
+-- Nothing sweeps the table on a timer: reads ignore expired rows, and every 'put'
+-- deletes them, so it works the same against any Postgres server.
+module Cloud.SelfHost.Ephemeral
+  ( put,
+    get,
+    take,
+  )
+where
+
+import Cloud.Postgres qualified as PG
+import Cloud.Prelude
+import Data.Time (DiffTime, NominalDiffTime)
+import Prelude hiding (take)
+
+-- | Replaces any value already at the key, expired or not.
+put :: Text -> NominalDiffTime -> ByteString -> PG.Transaction e ()
+put key ttl value = do
+  let interval = realToFrac ttl :: DiffTime
+  PG.execute_
+    [PG.sql|
+        DELETE FROM selfhost.ephemeral WHERE expires_at < now()
+      |]
+  PG.execute_
+    [PG.sql|
+        INSERT INTO selfhost.ephemeral (key, value, expires_at)
+          VALUES (#{key}, #{value}, now() + #{interval})
+          ON CONFLICT (key) DO UPDATE
+            SET value = EXCLUDED.value, expires_at = EXCLUDED.expires_at
+      |]
+
+get :: Text -> PG.Transaction e (Maybe ByteString)
+get key =
+  PG.query1Col
+    [PG.sql|
+        SELECT value FROM selfhost.ephemeral WHERE key = #{key} AND expires_at > now()
+      |]
+
+-- | Reads and deletes in one statement, so of two concurrent takes only one gets the value.
+take :: Text -> PG.Transaction e (Maybe ByteString)
+take key =
+  PG.query1Col
+    [PG.sql|
+        DELETE FROM selfhost.ephemeral WHERE key = #{key} AND expires_at > now()
+          RETURNING value
+      |]
