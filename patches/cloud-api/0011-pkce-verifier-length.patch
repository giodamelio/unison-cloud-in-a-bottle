+-- | An S256 pair for the login against the provider. share-auth's generatePkce encodes
+-- 30 random bytes, a 40-character verifier, under RFC 7636 §4.1's minimum of 43, which
+-- providers such as Pocket ID enforce. 32 bytes make 43 characters.
+generatePkce :: IO (PKCEVerifier, PKCEChallenge)
+generatePkce = do
+  verifier <- base64URL <$> Crypto.getRandomBytes @IO @ByteString 32
+  let challenge = base64URL (Crypto.hashWith Crypto.SHA256 (Text.encodeUtf8 verifier))
+  pure (PKCEVerifier verifier, PKCEChallenge challenge)
+  where
+    base64URL :: (ByteArrayAccess bytes) => bytes -> Text
+    base64URL = Text.decodeUtf8 . BE.convertToBase BE.Base64URLUnpadded
+
