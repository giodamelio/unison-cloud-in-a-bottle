+-- | Why the allowlist refused a login. Each names only what the provider sent about the
+-- user, never the allowlist, which a refused user has no business reading.
+data Refusal
+  = NoEmail
+  | UnverifiedEmail Text
+  | EmailNotListed Text
+  | NoGroups
+  | GroupsNotListed (Set.Set Text)
+
+refusalMessage :: Refusal -> Text
+refusalMessage = \case
+  NoEmail -> "The identity provider sent no email address for your account, and this server only lets in listed addresses."
+  UnverifiedEmail email -> "The identity provider hasn't verified your email address, " <> email <> ", and this server only lets in verified addresses."
+  EmailNotListed email -> "Your email address, " <> email <> ", isn't one this server lets in."
+  NoGroups -> "The identity provider sent no groups for your account, and this server only lets in members of certain groups."
+  GroupsNotListed groups -> "None of your groups (" <> Text.intercalate ", " (Set.toList groups) <> ") may log in to this server."
+
